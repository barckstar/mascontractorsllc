# Cloudflare Turnstile (captcha del formulario de contacto)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: validan el captcha y envían el correo por EmailJS (/api/contact).
# En EmailJS activa "Allow EmailJS API for non-browser applications" (Account > Security).
TURNSTILE_SECRET_KEY=
# El servidor reutiliza NEXT_PUBLIC_EMAILJS_{SERVICE_ID,TEMPLATE_ID,PUBLIC_KEY}; solo la
# Private Key es nueva. (EMAILJS_{SERVICE_ID,TEMPLATE_ID,PUBLIC_KEY} las sobrescriben si existen.)
EMAILJS_PRIVATE_KEY=
# Chequeo diario (Vercel Cron -> /api/cron/contact-check). CRON_SECRET: Vercel lo envía solo.
CRON_SECRET=
# Opcional: URL de webhook (Slack/Discord/ntfy) a la que avisar al DUEÑO cuando el chequeo falla
# (p. ej. https://ntfy.sh/<tema-privado-largo>). El chequeo no envía correos a la oficina.
ALERT_WEBHOOK_URL=
# 1 = avisar también cuando el chequeo sale bien (útil los primeros días; luego quitar).
ALERT_NOTIFY_SUCCESS=

# Server-only (no NEXT_PUBLIC_): live Google reviews via Places API (New).
# Without them the site shows the snapshot in src/lib/reviewsSnapshot.js.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
