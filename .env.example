# Cloudflare Turnstile (captcha del formulario de contacto)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: validan el captcha y envían el correo por EmailJS (/api/contact).
# En EmailJS activa "Allow EmailJS API for non-browser applications" (Account > Security).
TURNSTILE_SECRET_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Secreto del chequeo diario (mismo valor en Secrets de GitHub como MONITOR_SECRET)
MONITOR_SECRET=

# Server-only (no NEXT_PUBLIC_): live Google reviews via Places API (New).
# Without them the site shows the snapshot in src/lib/reviewsSnapshot.js.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
