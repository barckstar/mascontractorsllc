# Cloudflare Turnstile (captcha del formulario de contacto)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: validan el captcha y envían el correo por EmailJS (/api/contact).
# En EmailJS activa "Allow EmailJS API for non-browser applications" (Account > Security).
TURNSTILE_SECRET_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Chequeo diario (Vercel Cron -> /api/cron/contact-check). CRON_SECRET: Vercel lo envía solo.
CRON_SECRET=
# Opcional: URL de webhook (Slack/Discord/ntfy) a la que avisar cuando el chequeo falla.
ALERT_WEBHOOK_URL=

# Server-only (no NEXT_PUBLIC_): live Google reviews via Places API (New).
# Without them the site shows the snapshot in src/lib/reviewsSnapshot.js.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
